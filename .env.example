# ==============================================================================
# OOBE Capital Agent - Environment Configuration
# ==============================================================================

# Solana Network Configuration
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional Dedicated RPC (Helius, QuickNode, Triton)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Agent Wallet Keypair (Base58 encoded secret key or file path)
# WARNING: Keep private key safe! Fund with min 20 USDC or equivalent SOL.
AGENT_PRIVATE_KEY=your_base58_private_key_here

# Execution Mode: "simulation" (dry-run with simulated onchain state) or "live"
EXECUTION_MODE=simulation

# Autonomous Loop Configuration
POLL_INTERVAL_MS=15000
MAX_CONCURRENT_ACTIONS=2

# OOBE Protocol / Steve Capital Guardrails
MAX_ALLOCATION_PER_TRADE_USD=50.0
MAX_DAILY_VOLUME_USD=500.0
MIN_SOL_RESERVE_GAS=0.05
MAX_SLIPPAGE_BPS=50
CIRCUIT_BREAKER_MAX_DRAWDOWN_PCT=10.0

# Protocol Integrations
STEVE_MCP_ENDPOINT=https://steve.oobeprotocol.ai/mcp
MULTI_HOPPER_ENABLED=true
MULTI_HOPPER_API_URL=https://api.multihopper.com/v1
ACE_DATA_CLOUD_API_KEY=your_ace_api_key_here
